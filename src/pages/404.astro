---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="الصفحة غير موجودة — رصيد">
  <main class="nf">
    <div class="wrap">
      <p class="code">٤٠٤</p>
      <h1>الصفحة دي مش موجودة</h1>
      <p class="body">يمكن الرابط اتغيّر أو فيه خطأ بسيط. ترجع للصفحة الرئيسية وتكمّل؟</p>
      <a class="btn" href={`${base}/`}>الصفحة الرئيسية</a>
    </div>
  </main>
</Base>

<style>
  .nf { min-height: 80vh; display: grid; place-items: center; text-align: center; }
  .code { font-family: var(--font-display); font-size: clamp(4rem, 16vw, 9rem); font-weight: 700; color: var(--maroon-700); line-height: 1; }
  .nf h1 { font-size: var(--step-2xl); margin-block: var(--s-2) var(--s-1); }
  .nf .body { color: var(--muted); max-width: 44ch; margin-inline: auto; }
  .btn { display: inline-block; margin-block-start: var(--s-4); background: var(--gold-500); color: oklch(0.22 0.05 60); font-weight: 800; padding: .9rem 1.8rem; border-radius: var(--radius); transition: transform .15s var(--ease-out); }
  .btn:hover { transform: translateY(-2px); }
</style>