---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
const base = import.meta.env.BASE_URL;

// لقطات الشاشة — أسقط ملفًا باسم الـid (مثل dashboard.png أو trial-balance.webp) في src/assets/shots/
// فيُعرض تلقائيًا مُحسَّنًا (WebP + أبعاد + lazy)؛ وإلا يبقى الإطار placeholder. drop-in بلا تعديل كود.
const shotModules = import.meta.glob('../assets/shots/*.{webp,png,jpg,jpeg,avif}', { eager: true });
const shots = {};
for (const [path, mod] of Object.entries(shotModules)) {
  const name = path.split('/').pop().replace(/\.(webp|png|jpe?g|avif)$/i, '');
  shots[name] = mod.default;
}
const apk = 'https://github.com/mahmoudmamdouh2270-lgtm/rasid-download/releases/latest/download/rasid.apk';
// بصمة SHA-256 لإصدار v1.6.0 (rasid.apk) — مطابقة لِما هو منشور على GitHub Release.
const sha256 = 'c156241d0e149631b176a6d400bd92bad543b057f180fb5d7bc4781b51c5f91c';

// قنوات التواصل — املأ القيم لما توصل؛ يُعرض زر القناة اللي ليها قيمة فقط (مفيش روابط مكسورة).
const contact = {
  whatsapp: '201148889091', // رقم دولي بدون + أو 00
  linkedin: 'https://www.linkedin.com/in/mahmoud-mamdouh2270/',
  email: 'mahmoud.mamdouh2270@gmail.com',
};
const contactLinks = [
  contact.whatsapp && { id: 'whatsapp', label: 'واتساب', href: `https://wa.me/${contact.whatsapp}` },
  contact.linkedin && { id: 'linkedin', label: 'لينكدإن', href: contact.linkedin },
  contact.email && { id: 'email', label: 'إيميل', href: `mailto:${contact.email}` },
].filter(Boolean);

const nav = [
  { href: '#about', label: 'عن رصيد' },
  { href: '#features', label: 'المميزات' },
  { href: '#screens', label: 'الشاشات' },
  { href: '#security', label: 'الأمان' },
  { href: '#faq', label: 'أسئلة' },
  ...(contactLinks.length > 0 ? [{ href: '#contact', label: 'تواصل' }] : []),
];

const features = [
  { t: 'فواتير وضريبة', d: 'فواتير بيع وشراء بأرقام تلقائية، حساب ضريبة القيمة المضافة، وتصدير PDF احترافي.' },
  { t: 'مخزون بتكلفة دقيقة', d: 'متوسط مرجّح أو FIFO، تتبّع الكميات، وتنبيه عند نقص الرصيد.' },
  { t: 'عملاء وموردون وأقساط', d: 'أرصدة لحظية، كشوف حساب، سُلف ومقدّمات، وأقساط بمواعيد استحقاق.' },
  { t: 'تقارير تتكلم لغتك', d: 'ربحية، مركز مالي، تدفق نقدي، وشارتس واضحة — تراكمية أو لفترة تختارها.' },
  { t: 'قفل الفترات', d: 'تقفل شهرًا منتهيًا فيُمنع أي تعديل بأثر رجعي — حماية لسجلاتك.' },
  { t: 'يعمل بدون إنترنت', d: 'كل بياناتك على جهازك، مع مزامنة سحابية مشفّرة عند توفّر الشبكة.' },
];

const screens = [
  { id: 'dashboard', t: 'الداشبورد', d: 'نظرة واحدة على نقديتك، مديونياتك، وأرباحك — مع اتجاه التدفق النقدي لآخر ٦ شهور.' },
  { id: 'transactions', t: 'تسجيل المعاملات', d: 'بيع، شراء، تحصيل، أو مصروف في ثوانٍ. كل عملية تتحوّل لقيد محاسبي سليم تلقائيًا.' },
  { id: 'invoices', t: 'الفواتير', d: 'أصدر فاتورة بضريبة، حصّل دفعات جزئية أو أقساط، وصدّرها PDF لعميلك.' },
  { id: 'inventory', t: 'المخزون', d: 'منتجاتك بأرصدتها وتكلفتها الحقيقية (متوسط مرجّح/FIFO)، وتكلفة المبيعات تُحسب بدقّة.' },
  { id: 'journal', t: 'دفتر اليومية', d: 'كل عملية بقيدها المزدوج (مدين/دائن) في دفتر يومية عام قابل للفلترة — شفافية كاملة.' },
  { id: 'trial-balance', t: 'ميزان المراجعة', d: 'أرصدة كل الحسابات مع تأكيد أن إجمالي المدين = الدائن، وتصدير PDF.' },
  { id: 'reports', t: 'التقارير', d: 'أرباح وخسائر، مركز مالي، سيولة، وتقارير ضريبية — برسوم بيانية مفهومة.' },
];

const steps = [
  { t: 'جهّز نشاطك', d: 'اسم المشروع، طريقة التكلفة، ووسائل الدفع — مرة واحدة.' },
  { t: 'أضف منتجاتك وأطرافك', d: 'الكتالوج والعملاء والموردون بأرصدتهم الافتتاحية.' },
  { t: 'سجّل عملياتك اليومية', d: 'بيع، شراء، تحصيل، مصروف — والقيود تتولّد لوحدها.' },
  { t: 'اقرأ تقاريرك', d: 'افتح اليومية والميزان والربحية في أي وقت.' },
  { t: 'اقفل الفترة', d: 'عند انتهاء الشهر، اقفله لحماية أرقامك.' },
];

const faq = [
  { q: 'إزاي أبدأ؟', a: 'نزّل ملف الـAPK من زر التحميل، ثبّته، واتبع خطوات الإعداد الخمس داخل التطبيق — تبدأ تسجّل عملياتك في دقائق.' },
  { q: 'هل يعمل بدون إنترنت؟', a: 'نعم بالكامل. بياناتك محفوظة على جهازك، والمزامنة السحابية تحصل عند توفّر الشبكة.' },
  { q: 'هل بياناتي آمنة؟', a: 'قاعدة بياناتك على الجهاز مشفّرة، والمزامنة معزولة لكل مستخدم. بياناتك ملكك وحدك.' },
  { q: 'محتاج أكون محاسب؟', a: 'لا. تسجّل عملياتك بلغة بسيطة، ورصيد يحوّلها لقيود ومحاسبة سليمة خلف الكواليس.' },
  { q: 'إزاي أحدّث التطبيق؟', a: 'نزّل أحدث إصدار من زر التحميل وثبّته فوق نسختك — بياناتك تفضل محفوظة.' },
  { q: 'متاح على أي أجهزة؟', a: 'أندرويد 6.0 فأحدث حاليًا.' },
];
---
<Base>
  <header class="site-head" id="head">
    <div class="wrap head-inner">
      <a class="brand" href="#top">
        <img src={`${base}/rasid-logo.png`} alt="شعار رصيد" width="38" height="38" />
        <span>رصيد</span>
      </a>
      <nav class="nav">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      <a class="btn-sm" href="#download">تحميل</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker">محاسبة يومية · عربي بالكامل · بدون إنترنت</p>
          <h1>تمسك فلوس مشروعك<br /><span class="hl">بثقة محاسب</span></h1>
          <p class="lede">
            رصيد بيحوّل كل بيع وشراء وتحصيل إلى قيد محاسبي سليم، ويطلّعلك دفتر يومية
            وميزان مراجعة وتقارير ربحية — من غير ما تكون محاسب.
          </p>
          <div class="hero-cta">
            <a class="btn" href={apk}>تحميل التطبيق (APK)</a>
            <a class="btn-ghost" href="#screens">شوف الشاشات</a>
          </div>
          <p class="hero-meta">أندرويد 6.0+ · ~87MB · أحدث إصدار v1.6.0</p>
        </div>
        <div class="hero-art">
          <div class="phone">
            {shots['dashboard']
              ? <Image src={shots['dashboard']} alt="لوحة رصيد الرئيسية: النقدية والمديونيات والأرباح" loading="eager" />
              : <span>صورة الداشبورد</span>}
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT + تفاعل «عملية → قيد» -->
    <section id="about" class="section reveal">
      <div class="wrap about-grid">
        <div>
          <h2>محاسبة حقيقية، بلغة صاحب المحل</h2>
          <p class="body">
            معظم التطبيقات بتسجّل «دخل وخرج» وخلاص. رصيد بيشتغل بنظام القيد المزدوج
            الحقيقي: كل عملية ليها طرفان متوازنان، فأرقامك دايمًا متّسقة وقابلة للمراجعة.
          </p>
          <p class="body">
            النتيجة: تعرف ربحك الفعلي، ديونك ومديونياتك، قيمة مخزونك، وموقفك المالي —
            في أي لحظة، وبثقة.
          </p>
        </div>
        <figure class="ledger" aria-label="مثال: بيع نقدي يتحوّل إلى قيد مزدوج">
          <div class="op">بيع نقدي · ٥٠٠ ج.م</div>
          <div class="to">يتحوّل تلقائيًا إلى</div>
          <div class="entry">
            <div class="line l1"><span>النقدية</span><span class="dr">مدين ٥٠٠</span></div>
            <div class="line l2"><span>الإيرادات</span><span class="cr">دائن ٥٠٠</span></div>
            <div class="bal">متوازن ✓</div>
          </div>
        </figure>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="section alt reveal">
      <div class="wrap">
        <h2>كل اللي محتاجه محلّك في مكان واحد</h2>
        <div class="feat-lead">
          <h3>القيد المزدوج التلقائي</h3>
          <p class="body">القلب اللي بيخلّي كل تقاريرك صح: كل عملية تتسجّل بطرفيها لحظيًا، بلا مجهود منك.</p>
        </div>
        <ul class="feat-grid">
          {features.map((f) => (
            <li><h3>{f.t}</h3><p>{f.d}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SCREENS walkthrough -->
    <section id="screens" class="section reveal">
      <div class="wrap">
        <h2>جولة داخل التطبيق</h2>
        <div class="screens">
          {screens.map((s, i) => (
            <article class={`screen-row ${i % 2 ? 'flip' : ''}`}>
              <div class="phone">
                {shots[s.id]
                  ? <Image src={shots[s.id]} alt={`شاشة ${s.t} في تطبيق رصيد`} loading="lazy" />
                  : <span>صورة: {s.t}</span>}
              </div>
              <div class="screen-copy">
                <h3>{s.t}</h3>
                <p class="body">{s.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW -->
    <section id="how" class="section alt reveal">
      <div class="wrap">
        <h2>تبدأ في خمس خطوات</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SECURITY -->
    <section id="security" class="section reveal">
      <div class="wrap sec-grid">
        <div>
          <h2>بياناتك ملكك، ومحميّة</h2>
          <ul class="sec-list">
            <li><strong>تشفير على الجهاز:</strong> قاعدة بياناتك مشفّرة محليًا، مش نص مكشوف.</li>
            <li><strong>مزامنة معزولة:</strong> كل مستخدم بمعزل عن غيره عند المزامنة السحابية.</li>
            <li><strong>ملكية كاملة:</strong> بياناتك بتاعتك، تصدّرها وتنقلها وقت ما تحب.</li>
            <li><strong>تحميل موثّق:</strong> ننشر بصمة SHA-256 للملف عشان تتأكد إنه أصلي.</li>
          </ul>
        </div>
        <div class="sec-side">
          <p class="body">صُمّم رصيد بحيث يكون مصدر الحقيقة لأرقام مشروعك — بأمان وخصوصية من الأساس.</p>
        </div>
      </div>
    </section>

    <!-- DOWNLOAD -->
    <section id="download" class="section alt reveal">
      <div class="wrap dl">
        <h2>حمّل رصيد دلوقتي</h2>
        <a class="btn" href={apk}>تحميل التطبيق (APK)</a>
        <p class="hero-meta">أندرويد 6.0+ · ~87MB · v1.6.0</p>
        <p class="play-soon"><span class="dot" aria-hidden="true"></span>قريبًا على Google Play</p>
        <ol class="install">
          <li>نزّل ملف الـAPK.</li>
          <li>افتحه، واسمح بالتثبيت من المصدر لو طُلب.</li>
          <li>ثبّت وافتح «رصيد» وابدأ.</li>
        </ol>
        <div class="checksum">
          <p class="checksum-label">بصمة SHA-256 للملف — اتأكد إن اللي نزّلته هو الأصلي:</p>
          <code class="checksum-hash" dir="ltr">{sha256}</code>
          <p class="checksum-how">على ويندوز: <code dir="ltr">certutil -hashfile rasid.apk SHA256</code> · على أندرويد/لينكس: <code dir="ltr">sha256sum rasid.apk</code></p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section reveal">
      <div class="wrap">
        <h2>أسئلة شائعة</h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <div class="faq-a"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
    {contactLinks.length > 0 && (
      <!-- CONTACT -->
      <section id="contact" class="section alt reveal">
        <div class="wrap contact">
          <h2>محتاج مساعدة أو عندك سؤال؟</h2>
          <p class="body">تواصل معنا مباشرة على القناة اللي تريحك، ونرد عليك بأسرع وقت.</p>
          <div class="contact-row">
            {contactLinks.map((c) => (
              <a class={`contact-btn ${c.id}`} href={c.href} target="_blank" rel="noopener noreferrer">
                {c.id === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M.06 24l1.7-6.2A11.9 11.9 0 1112 24a12 12 0 01-6.1-1.66L.06 24zM6.6 20.13l.37.22a9.9 9.9 0 005.05 1.38 9.93 9.93 0 10-9.93-9.93c0 1.78.47 3.5 1.37 5.02l.24.4-1 3.66 3.93-.75zM17.5 14.3c-.07-.12-.26-.2-.55-.34s-1.72-.85-1.99-.94-.46-.14-.65.14-.74.94-.91 1.13-.34.21-.62.07a8.13 8.13 0 01-2.4-1.48 9 9 0 01-1.66-2.06c-.17-.3 0-.45.13-.6.13-.13.28-.34.42-.5.14-.18.18-.3.28-.5.09-.21.05-.38-.02-.53s-.65-1.57-.9-2.15c-.23-.56-.47-.48-.65-.49h-.55a1.06 1.06 0 00-.77.36 3.22 3.22 0 00-1 2.4 5.58 5.58 0 001.17 2.96 12.78 12.78 0 004.9 4.33c.68.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.55-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38z"/></svg>
                )}
                {c.id === 'linkedin' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 110-4.13 2.07 2.07 0 010 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                )}
                {c.id === 'email' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M2 4h20a2 2 0 012 2v12a2 2 0 01-2 2H2a2 2 0 01-2-2V6a2 2 0 012-2zm10 7.4L3.3 6H20.7L12 11.4zm0 2.3l9-5.6V18H3V8.1l9 5.6z"/></svg>
                )}
                <span>{c.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="site-foot">
    <div class="wrap foot-inner">
      <span>رصيد © 2026 — جميع الحقوق محفوظة</span>
      <a href={apk}>تحميل التطبيق</a>
    </div>
  </footer>
</Base>

<style>
  /* HEADER */
  .site-head { position: sticky; top: 0; z-index: 50; background: color-mix(in oklch, var(--paper) 80%, transparent); backdrop-filter: saturate(1.3) blur(10px); border-block-end: 1px solid transparent; transition: border-color .3s var(--ease-out), background .3s var(--ease-out); }
  .site-head.scrolled { border-block-end-color: var(--line); background: color-mix(in oklch, var(--paper) 92%, transparent); }
  .head-inner { display: flex; align-items: center; gap: var(--s-4); height: 64px; }
  .brand { display: flex; align-items: center; gap: .5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .brand img { border-radius: 9px; }
  .nav { display: flex; gap: clamp(.6rem, 2vw, 1.5rem); margin-inline-start: auto; font-size: var(--step-sm); font-weight: 600; }
  .nav a { color: var(--muted); }
  .nav a:hover { color: var(--maroon-700); }
  .btn-sm { background: var(--maroon-700); color: var(--paper); padding: .5rem 1.1rem; border-radius: 999px; font-weight: 700; font-size: var(--step-sm); transition: transform .15s var(--ease-out); }
  .btn-sm:hover { transform: translateY(-1px); }
  @media (max-width: 720px) { .nav { display: none; } }

  /* HERO */
  .hero { background: radial-gradient(120% 90% at 88% -10%, var(--maroon-500), transparent 55%), linear-gradient(160deg, var(--maroon-900), var(--maroon-700)); color: var(--paper); padding-block: clamp(3.5rem, 9vw, 7rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: var(--s-5); align-items: center; }
  .kicker { color: var(--gold-300); font-weight: 700; font-size: var(--step-sm); margin-block-end: var(--s-2); }
  .hero h1 { font-size: var(--step-hero); line-height: 1.12; }
  .hero .hl { color: var(--gold-300); }
  .lede { font-size: var(--step-lg); line-height: 1.8; max-width: 46ch; margin-block: var(--s-3) var(--s-4); color: color-mix(in oklch, var(--paper) 90%, var(--maroon-500)); }
  .hero-cta { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .btn { background: var(--gold-500); color: oklch(0.22 0.05 60); font-weight: 800; padding: .95rem 1.8rem; border-radius: var(--radius); font-size: var(--step-md); transition: transform .15s var(--ease-out), box-shadow .2s var(--ease-out); }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -12px oklch(0.55 0.14 70 / .6); }
  .btn-ghost { color: var(--paper); border: 1px solid color-mix(in oklch, var(--paper) 45%, transparent); padding: .95rem 1.5rem; border-radius: var(--radius); font-weight: 700; transition: background .2s var(--ease-out); }
  .btn-ghost:hover { background: color-mix(in oklch, var(--paper) 12%, transparent); }
  .hero-meta { margin-block-start: var(--s-3); font-size: var(--step-sm); color: color-mix(in oklch, var(--paper) 70%, var(--maroon-500)); }
  .hero-art { display: flex; justify-content: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { order: -1; } }

  /* phone frame (shared) */
  .phone { width: min(248px, 68vw); aspect-ratio: 9 / 19; border-radius: 30px; overflow: hidden; background: color-mix(in oklch, var(--paper) 10%, var(--maroon-900)); border: 2px solid color-mix(in oklch, var(--gold-300) 35%, transparent); display: grid; place-items: center; color: color-mix(in oklch, var(--paper) 55%, transparent); font-size: var(--step-sm); text-align: center; box-shadow: 0 30px 60px -22px oklch(0.1 0.05 350 / .55); }
  .phone :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
