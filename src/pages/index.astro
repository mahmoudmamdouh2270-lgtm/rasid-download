---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const apk = 'https://github.com/mahmoudmamdouh2270-lgtm/rasid-download/releases/latest/download/rasid.apk';
const nav = [
  { href: '#about', label: 'عن رصيد' },
  { href: '#features', label: 'المميزات' },
  { href: '#screens', label: 'الشاشات' },
  { href: '#security', label: 'الأمان' },
  { href: '#faq', label: 'أسئلة' },
];
---
<Base>
  <header class="site-head">
    <div class="wrap head-inner">
      <a class="brand" href="#top">
        <img src={`${base}/rasid-logo.png`} alt="شعار رصيد" width="40" height="40" />
        <span>رصيد</span>
      </a>
      <nav class="nav">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="btn-sm" href="#download">تحميل</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO — drenched نبيتي -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker">محاسبة يومية. عربي بالكامل. بدون إنترنت.</p>
          <h1>تمسك فلوس مشروعك<br /><span class="hl">بثقة محاسب</span></h1>
          <p class="lede">
            رصيد بيحوّل كل عملية بيع وشراء وتحصيل إلى قيد محاسبي سليم،
            ويطلّعلك دفتر يومية وميزان مراجعة وتقارير ربحية — من غير ما تكون محاسب.
          </p>
          <div class="hero-cta">
            <a class="btn" href={apk}>تحميل التطبيق (APK)</a>
            <a class="btn-ghost" href="#screens">شوف الشاشات</a>
          </div>
          <p class="hero-meta">أندرويد 6.0+ · ~87MB · أحدث إصدار v1.6.0</p>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="phone"><span>صورة الداشبورد</span></div>
        </div>
      </div>
    </section>

    <!-- شِل الأقسام (المحتوى في S2، الصور في S3) -->
    <section id="about" class="section reveal">
      <div class="wrap"><h2>ما هو رصيد؟</h2><p class="stub">[S2]</p></div>
    </section>
    <section id="features" class="section alt reveal">
      <div class="wrap"><h2>نظرة على المميزات</h2><p class="stub">[S2]</p></div>
    </section>
    <section id="screens" class="section reveal">
      <div class="wrap"><h2>جولة داخل التطبيق</h2><p class="stub">[S2 + صور S3]</p></div>
    </section>
    <section id="how" class="section alt reveal">
      <div class="wrap"><h2>إزاي تستخدمه</h2><p class="stub">[S2]</p></div>
    </section>
    <section id="security" class="section reveal">
      <div class="wrap"><h2>أمان وخصوصية</h2><p class="stub">[S2 + S4]</p></div>
    </section>
    <section id="download" class="section alt reveal">
      <div class="wrap">
        <h2>حمّل رصيد</h2>
        <a class="btn" href={apk}>تحميل التطبيق (APK)</a>
        <p class="stub">[S4: SHA-256 + خطوات التثبيت]</p>
      </div>
    </section>
    <section id="faq" class="section reveal">
      <div class="wrap"><h2>أسئلة شائعة</h2><p class="stub">[S2]</p></div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">رصيد © 2026 — جميع الحقوق محفوظة</div>
  </footer>
</Base>

<style>
  .site-head {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklch, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-block-end: 1px solid var(--line);
  }
  .head-inner { display: flex; align-items: center; gap: var(--s-4); height: 64px; }
  .brand { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .brand img { border-radius: 9px; }
  .nav { display: flex; gap: clamp(0.6rem, 2vw, 1.5rem); margin-inline-start: auto; font-size: var(--step-sm); font-weight: 600; }
  .nav a { color: var(--muted); }
  .nav a:hover { color: var(--maroon-700); }
  .btn-sm { background: var(--maroon-700); color: var(--paper); padding: 0.5rem 1.1rem; border-radius: 999px; font-weight: 700; font-size: var(--step-sm); }
  @media (max-width: 720px) { .nav { display: none; } }

  /* HERO */
  .hero {
    background:
      radial-gradient(120% 90% at 85% -10%, var(--maroon-500), transparent 55%),
      linear-gradient(160deg, var(--maroon-900), var(--maroon-700));
    color: var(--paper);
    padding-block: clamp(3.5rem, 9vw, 7rem);
    overflow: hidden;
  }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--s-5); align-items: center; }
  .kicker { color: var(--gold-300); font-weight: 700; font-size: var(--step-sm); letter-spacing: 0.02em; margin-block-end: var(--s-2); }
  .hero h1 { font-size: var(--step-hero); line-height: 1.12; }
  .hero .hl { color: var(--gold-300); }
  .lede { font-size: var(--step-lg); line-height: 1.75; max-width: 46ch; margin-block: var(--s-3) var(--s-4); color: color-mix(in oklch, var(--paper) 90%, var(--maroon-500)); }
  .hero-cta { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .btn { background: var(--gold-500); color: oklch(0.22 0.05 60); font-weight: 800; padding: 0.95rem 1.8rem; border-radius: var(--radius); font-size: var(--step-md); transition: transform .15s var(--ease-out); }
  .btn:hover { transform: translateY(-2px); }
  .btn-ghost { color: var(--paper); border: 1px solid color-mix(in oklch, var(--paper) 45%, transparent); padding: 0.95rem 1.5rem; border-radius: var(--radius); font-weight: 700; }
  .hero-meta { margin-block-start: var(--s-3); font-size: var(--step-sm); color: color-mix(in oklch, var(--paper) 70%, var(--maroon-500)); }
  .hero-art { display: flex; justify-content: center; }
  .phone { width: min(260px, 70vw); aspect-ratio: 9 / 19; border-radius: 30px; background: color-mix(in oklch, var(--paper) 12%, var(--maroon-900)); border: 2px solid color-mix(in oklch, var(--gold-300) 40%, transparent); display: grid; place-items: center; color: color-mix(in oklch, var(--paper) 60%, transparent); font-size: var(--step-sm); box-shadow: 0 30px 60px -20px oklch(0.1 0.05 350 / 0.6); }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { order: -1; } }

  /* SECTIONS (shells) */
  .section.alt { background: var(--paper-2); }
  .section h2 { font-size: var(--step-2xl); margin-block-end: var(--s-3); }
  .stub { color: var(--muted); font-style: italic; }
  .section .btn { display: inline-block; }

  .site-foot { padding-block: var(--s-4); border-block-start: 1px solid var(--line); color: var(--muted); font-size: var(--step-sm); text-align: center; }
</style>